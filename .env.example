# PostgreSQL 연결 (로컬 개발 기본값)
DATABASE_URL="postgresql://valuemap:valuemap@localhost:5432/valuemap?schema=public"

# DART OpenAPI (무료, https://opendart.fss.or.kr 에서 발급)
DART_API_KEY="여기에_DART_키"

# 한국투자증권 KIS Developers (https://apiportal.koreainvestment.com)
KIS_APP_KEY=""
KIS_APP_SECRET=""

# AI 분석 (핵심 차별 기능)
# 키 발급: https://console.anthropic.com
# 비어 있으면 public/ai-samples/*.json 사전 생성 샘플로 대체됩니다.

# Naver login exposure gates.
# Both values must be true. Keep review approval false until Naver confirms the public review.
NEXT_PUBLIC_ENABLE_NAVER_LOGIN="false"
NEXT_PUBLIC_NAVER_REVIEW_APPROVED="false"

# 검색엔진 소유권 확인 토큰(선택 · 운영자 전용 · 절대 커밋 금지).
# 값이 비어 있으면 소유권 <meta> 태그를 방출하지 않는다(로컬 빌드는 토큰 불필요).
# Google Search Console > 소유권 확인 > HTML 태그에서 발급한 content 값.
GOOGLE_SITE_VERIFICATION=""
# Naver Search Advisor(서치어드바이저) > 사이트 소유확인 > HTML 태그에서 발급한 content 값.
NAVER_SITE_VERIFICATION=""
